# Copy to .env and fill from Supabase: Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY

# Optional: included in the User-Agent for OpenStreetMap address search (Nominatim)
# GEOCODING_CONTACT_EMAIL=you@example.com
